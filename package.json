{
  "name": "burrow-siege",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node scripts/check-browser.mjs",
    "check:export": "node scripts/check-export.mjs",
    "generate:share": "node scripts/generate-share.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "tsx": "^4.20.0",
    "playwright": "^1.58.0",
    "@axe-core/playwright": "^4.11.0"
  }
}
